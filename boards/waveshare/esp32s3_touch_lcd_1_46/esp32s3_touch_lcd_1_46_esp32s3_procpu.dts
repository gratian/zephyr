/dts-v1/;
#include <espressif/esp32s3/esp32s3_r8.dtsi>
#include "esp32s3_touch_lcd_1_46-pinctrl.dtsi"
#include <espressif/partitions_0x0_amp_16M.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/spi/spi.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "ESP32-S3-Touch-LCD-1.46 PROCPU";
	compatible = "espressif,esp32s3";

	aliases {
		sw0 = &button0;
		i2c-0 = &i2c0;
		uart-0 = &uart0;
		watchdog0 = &wdt0;
		rtc = &pcf85063a_rtc;
		pwm-0 = &ledc0;
		pwm-lcd0 = &pwm_lcd0;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,bt-hci = &esp32_bt_hci;
		zephyr,ipc = &ipm0;
		zephyr,ipc_shm = &shm0;
		zephyr,display = &spd2010_512x512;
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_lcd0: pwm_0 {
			label = "LCD backlight PWM";
			pwms = <&ledc0 0 PWM_HZ(250) PWM_POLARITY_NORMAL>;
		};
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&ledc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	status = "okay";

	pcf85063a_rtc: pcf85063a@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
		status = "okay";
	};

	tca9554: tca9554@20 {
		compatible = "nxp,pca9554";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		status = "okay";
	};

	spd2010_touch: spd2010-touch@53 {
		compatible = "solomon,spd2010-touch";
		reg = <0x53>;
		irq-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		rst-gpios = <&tca9554 0 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&spi2 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	half-duplex;
	d-pol-low;
	cs-hold-time = <1>;
	dma-enabled;
	dmas = <&dma 0>, <&dma 1>;
	dma-names = "rx", "tx";

	spd2010_512x512: spd2010@0 {
		compatible = "solomon,spd2010";
		reg = <0>;
		reset-gpios = <&tca9554 1 GPIO_ACTIVE_LOW>;
		spi-max-frequency = <80000000>;
		pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
		width = <412>;
		height = <412>;
		status = "okay";
	};
};

&usb_serial {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&ipm0 {
	status = "okay";
};

&dma {
	status = "okay";
};
