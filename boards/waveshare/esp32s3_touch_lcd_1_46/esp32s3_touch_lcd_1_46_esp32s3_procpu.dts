/dts-v1/;
#include <espressif/esp32s3/esp32s3_r8.dtsi>
#include "esp32s3_touch_lcd_1_46-pinctrl.dtsi"
#include <espressif/partitions_0x0_amp_16M.dtsi>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "ESP32-S3-Touch-LCD-1.46 PROCPU";
	compatible = "espressif,esp32s3";

	aliases {
		sw0 = &button0;
		i2c-0 = &i2c0;
		uart-0 = &uart0;
		watchdog0 = &wdt0;
		rtc = &pcf85063a_rtc;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
/*
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
*/
		zephyr,bt-hci = &esp32_bt_hci;
		zephyr,ipc = &ipm0;
		zephyr,ipc_shm = &shm0;
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	status = "okay";

	pcf85063a_rtc: pcf85063a@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
		int-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&usb_serial {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&ipm0 {
	status = "okay";
};
